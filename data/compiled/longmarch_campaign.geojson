    {
      "type": "Feature",
      "properties": {
        "id": "evt_001_departure",
        "type": "event",
        "title": "1. 战略突围·星夜渡过于都河",
        "description": "中央红军主力八万余人，分别在于都县的八个渡口渡过于都河，踏上战略突围长征路。这是整个长征史诗的起点。",
        "date_start": "1934-10-16",
        "date_end": "1934-10-20",
        "location_id": "loc_yudu",
        "importance": 5,
        "narrative_cues": [
          {
            "trigger": "on_enter",
            "action": "camera",
            "payload": {
              "heading": 180.0,
              "pitch": -30.0,
              "range": 12000.0
            }
          },
          {
            "trigger": "on_enter",
            "action": "subtitle",
            "payload": {
              "text": "【长征起点】中央红军八万精兵渡过于都河，长征第一步！"
            }
          }
        ],
        "media": [
          {
            "file": "assets/1jt.png",
            "caption": "于都河畔长征集结",
            "type": "image"
          }
        ]
      },
